# Автопубликация мотивационных постов
#
# Время задано в UTC, потому что сервер живёт по UTC, а CRON_TZ здесь не работает:
# это расширение cronie из Red Hat, в Debian и Ubuntu его нет. Строка CRON_TZ
# молча игнорируется, и задача уходит на три часа позже задуманного.
#
# 06:00 UTC = 09:00 МСК  картинка
# 09:00 UTC = 12:00 МСК  картинка
# 15:00 UTC = 18:00 МСК  ролик
# 18:00 UTC = 21:00 МСК  ролик
# 05:30 UTC = 08:30 МСК  сбор статистики YouTube, до первого слота
#
# Ролики стоят вечером: первые часы после выхода решают, пойдёт ли Shorts
# дальше тестовой порции показов, а ночью аудитория спит.
#
# Пересчёт безопасен навсегда: Москва с 2014 года стоит на UTC+3 и на летнее
# время не переходит.
#
# Часы слотов дублируются в SLOTS и REEL_SLOTS в .env — при изменении править оба места.
#
# Точное время внутри часа задаёт не cron, а сам скрипт: он выжидает от 15 до
# 30 минут случайно, поэтому посты выходят между HH:15 и HH:30, а не секунда
# в секунду. Ручной запуск пропускает паузу ключом --now.
#
# nice и ionice — чтобы публикация уступала дорогу VPN при любой конкуренции.
# Сборка ролика занимает около девяти секунд на одном ядре и укладывается сюда же.
#
# Ставится так:
#   sed 's/\r$//' /opt/motivation/deploy/motivation.cron > /etc/cron.d/motivation
#   chmod 644 /etc/cron.d/motivation
#   systemctl restart cron
#
# sed в первой строке обязателен: файл правится на Windows, оттуда приезжает
# с CRLF, и cron отвергает его целиком со строкой «bad minute» в syslog —
# молча перестают работать все задачи, а не одна. Проверять после установки:
#   grep -c 'Error.*motivation' /var/log/syslog

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 6  * * * root cd /opt/motivation/tools && nice -n 15 ionice -c3 ../venv/bin/python autopost.py >> /opt/motivation/cron.log 2>&1
0 9  * * * root cd /opt/motivation/tools && nice -n 15 ionice -c3 ../venv/bin/python autopost.py >> /opt/motivation/cron.log 2>&1
0 15 * * * root cd /opt/motivation/tools && nice -n 15 ionice -c3 ../venv/bin/python autopost.py >> /opt/motivation/cron.log 2>&1
0 18 * * * root cd /opt/motivation/tools && nice -n 15 ionice -c3 ../venv/bin/python autopost.py >> /opt/motivation/cron.log 2>&1
30 5 * * * root cd /opt/motivation/tools && nice -n 15 ionice -c3 ../venv/bin/python youtube_stats.py >> /opt/motivation/cron.log 2>&1
