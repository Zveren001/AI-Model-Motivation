# --- Instagram: аккаунт @mono.motiv ---
IG_USER_ID=28040512338943584
IG_ACCESS_TOKEN=

# Приложение Meta общее с проектом Ники
IG_APP_ID=2311192782748512
IG_APP_SECRET=

# --- Хранилище картинок ---
# Тот же репозиторий, что у Ники, но отдельная папка motivation/
GITHUB_TOKEN=
GITHUB_OWNER=Zveren001
GITHUB_REPO=nika-media
GITHUB_BRANCH=main

# --- Расписание ---
# Часы публикации по Москве через запятую. Те же часы в UTC стоят
# в deploy/motivation.cron — при изменении править оба места.
SLOTS=9,12,18,21
# Слоты, в которые выходят ролики; в остальные — картинки.
# Ролики стоят вечером: первые часы после выхода решают, пойдёт ли Shorts дальше.
REEL_SLOTS=18,21

# --- YouTube ---
# Инструкция: docs/youtube-api.md, перевыпуск токена: docs/youtube-token.md
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Ролики ---
# Ключ видеостока Pexels: pexels.com/api, выдаётся сразу после регистрации.
# Без него ролик берёт клип из кэша footage/, а при пустом кэше слот пропускается.
PEXELS_API_KEY=
# Голос озвучки edge-tts и его темп; Светлана — единственный русский женский голос
VOICE=ru-RU-SvetlanaNeural
VOICE_RATE=+0%
