{
  "quotes": [
    {
      "id": 1,
      "text": "Не жди подходящего момента, его не будет",
      "topic": "действие",
      "used": true,
      "used_at": "2026-08-23T01:38:56"
    },
    {
      "id": 2,
      "text": "Сложно только первые сто раз",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 3,
      "text": "Ты не отстаёшь, у тебя просто другой маршрут",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 4,
      "text": "Дисциплина это уважение к себе будущему",
      "topic": "дисциплина",
      "used": false,
      "used_at": null
    },
    {
      "id": 5,
      "text": "Начни плохо, исправишь потом",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 6,
      "text": "Никто не придёт и не спасёт, и это отличная новость",
      "topic": "ответственность",
      "used": false,
      "used_at": null
    },
    {
      "id": 7,
      "text": "Усталость проходит, сделанное остаётся",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 8,
      "text": "Сравнивай себя со вчерашним, остальные не участвуют",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 9,
      "text": "Мотивация заканчивается на третий день, привычка живёт годами",
      "topic": "дисциплина",
      "used": false,
      "used_at": null
    },
    {
      "id": 10,
      "text": "Ты не ленивый, ты уставший и это разные вещи",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 11,
      "text": "Маленький шаг сегодня лучше большого плана на понедельник",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 12,
      "text": "Тебе не нужно быть готовым, тебе нужно начать",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 13,
      "text": "Страх не исчезает, к нему просто привыкаешь",
      "topic": "страх",
      "used": false,
      "used_at": null
    },
    {
      "id": 14,
      "text": "Твоё время не потрачено зря, если ты чему-то научился",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 15,
      "text": "Отдых это часть работы, а не награда за неё",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 16,
      "text": "Тишина в голове дороже любого совета",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 17,
      "text": "Тот, кто идёт медленно, всё равно идёт",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 18,
      "text": "Хватит объяснять, начни показывать",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 19,
      "text": "Ты не обязан быть продуктивным каждый день",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 20,
      "text": "Лучше сделать и жалеть, чем не сделать и гадать",
      "topic": "решимость",
      "used": false,
      "used_at": null
    },
    {
      "id": 21,
      "text": "Твоя жизнь меняется в день, когда ты перестаёшь ждать разрешения",
      "topic": "решимость",
      "used": false,
      "used_at": null
    },
    {
      "id": 22,
      "text": "Если бы это было легко, это делали бы все",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 23,
      "text": "Не считай дни, делай так, чтобы дни считались",
      "topic": "время",
      "used": false,
      "used_at": null
    },
    {
      "id": 24,
      "text": "Успех это умение идти от неудачи к неудаче, не теряя интереса",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 25,
      "text": "Великое делают только те, кому не всё равно",
      "topic": "дело",
      "used": false,
      "used_at": null
    },
    {
      "id": 26,
      "text": "Падать не стыдно, стыдно остаться лежать",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 27,
      "text": "Начни там, где стоишь, тем, что имеешь",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 28,
      "text": "Секрет движения вперёд в том, чтобы начать",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 29,
      "text": "Без действия не бывает результата, даже плохого",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 30,
      "text": "У кого есть зачем, тот выдержит любое как",
      "topic": "смысл",
      "used": false,
      "used_at": null
    },
    {
      "id": 31,
      "text": "Мы то, что делаем каждый день, а не то, что решили однажды",
      "topic": "дисциплина",
      "used": false,
      "used_at": null
    },
    {
      "id": 32,
      "text": "Единственная невозможная мечта та, которую ты не пробовал",
      "topic": "мечта",
      "used": false,
      "used_at": null
    },
    {
      "id": 33,
      "text": "Дорогу осилит идущий",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 34,
      "text": "Вода камень точит не силой, а постоянством",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 35,
      "text": "Кто хочет, ищет возможности, кто не хочет, ищет причины",
      "topic": "решимость",
      "used": false,
      "used_at": null
    },
    {
      "id": 36,
      "text": "Твоё сегодняшнее решение станет твоей завтрашней реальностью",
      "topic": "выбор",
      "used": false,
      "used_at": null
    },
    {
      "id": 37,
      "text": "Никогда не поздно стать тем, кем ты мог бы быть",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 38,
      "text": "Жизнь на десять процентов из событий и на девяносто из твоей реакции",
      "topic": "отношение",
      "used": false,
      "used_at": null
    },
    {
      "id": 39,
      "text": "Если устал, отдыхай, но не сдавайся",
      "topic": "упорство",
      "used": false,
      "used_at": null
    },
    {
      "id": 40,
      "text": "Спокойствие это тоже сила",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 41,
      "text": "Не бойся идти медленно, бойся стоять на месте",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 42,
      "text": "Зона комфорта красивое место, но там ничего не растёт",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 43,
      "text": "Один час в день меняет год",
      "topic": "время",
      "used": false,
      "used_at": null
    },
    {
      "id": 44,
      "text": "Всё, чего ты хочешь, находится по другую сторону страха",
      "topic": "страх",
      "used": false,
      "used_at": null
    },
    {
      "id": 45,
      "text": "Не нужно видеть всю лестницу, достаточно первой ступени",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 46,
      "text": "Мы страдаем чаще в воображении, чем в реальности",
      "topic": "тревога",
      "used": false,
      "used_at": null
    },
    {
      "id": 47,
      "text": "Трудности не создают характер, они его показывают",
      "topic": "характер",
      "used": false,
      "used_at": null
    },
    {
      "id": 48,
      "text": "Важно не то, что случилось, а то, как ты это принял",
      "topic": "отношение",
      "used": false,
      "used_at": null
    },
    {
      "id": 49,
      "text": "Счастье зависит от нас самих больше, чем нам удобно думать",
      "topic": "счастье",
      "used": false,
      "used_at": null
    },
    {
      "id": 50,
      "text": "Побеждает тот, кто убедил себя, что победит",
      "topic": "вера",
      "used": false,
      "used_at": null
    },
    {
      "id": 51,
      "text": "Прогресс важнее совершенства",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 52,
      "text": "Сделанное лучше идеального",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 53,
      "text": "Дважды подумай, один раз сделай, но обязательно сделай",
      "topic": "действие",
      "used": false,
      "used_at": null
    },
    {
      "id": 54,
      "text": "Твои привычки решают больше, чем твои планы",
      "topic": "дисциплина",
      "used": false,
      "used_at": null
    },
    {
      "id": 55,
      "text": "Каждый эксперт когда-то был новичком",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 56,
      "text": "Не сравнивай своё начало с чужой серединой",
      "topic": "сравнение",
      "used": false,
      "used_at": null
    },
    {
      "id": 57,
      "text": "Терпение это не пассивность, это концентрация",
      "topic": "терпение",
      "used": false,
      "used_at": null
    },
    {
      "id": 58,
      "text": "Настоящая сила в том, чтобы быть мягким, когда можешь быть жёстким",
      "topic": "характер",
      "used": false,
      "used_at": null
    },
    {
      "id": 59,
      "text": "Отпусти то, что нельзя изменить, займись тем, что можно",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 60,
      "text": "Твоё внимание самая дорогая валюта, трать осознанно",
      "topic": "фокус",
      "used": false,
      "used_at": null
    },
    {
      "id": 61,
      "text": "Один сфокусированный час стоит дня рассеянности",
      "topic": "фокус",
      "used": false,
      "used_at": null
    },
    {
      "id": 62,
      "text": "Скажи нет лишнему, чтобы сказать да важному",
      "topic": "фокус",
      "used": false,
      "used_at": null
    },
    {
      "id": 63,
      "text": "Кто гонится за двумя зайцами, не поймает ни одного",
      "topic": "фокус",
      "used": false,
      "used_at": null
    },
    {
      "id": 64,
      "text": "Умение ждать это тоже действие",
      "topic": "терпение",
      "used": false,
      "used_at": null
    },
    {
      "id": 65,
      "text": "Ошибка это плата за опыт, и цена справедливая",
      "topic": "ошибки",
      "used": false,
      "used_at": null
    },
    {
      "id": 66,
      "text": "Провал не противоположность успеха, а его часть",
      "topic": "ошибки",
      "used": false,
      "used_at": null
    },
    {
      "id": 67,
      "text": "Никто не помнит твоих провалов так хорошо, как ты сам",
      "topic": "ошибки",
      "used": false,
      "used_at": null
    },
    {
      "id": 68,
      "text": "Ты имеешь право передумать",
      "topic": "свобода",
      "used": false,
      "used_at": null
    },
    {
      "id": 69,
      "text": "Иногда лучший выход это выйти",
      "topic": "выбор",
      "used": false,
      "used_at": null
    },
    {
      "id": 70,
      "text": "Не всё, что тебя ждёт, стоит того, чтобы ждать",
      "topic": "выбор",
      "used": false,
      "used_at": null
    },
    {
      "id": 71,
      "text": "Твоя ценность не измеряется твоей продуктивностью",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 72,
      "text": "Разреши себе быть новичком",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 73,
      "text": "Ты не должен нравиться всем, это математически невозможно",
      "topic": "принятие",
      "used": false,
      "used_at": null
    },
    {
      "id": 74,
      "text": "Чужое мнение о тебе это их дело, не твоё",
      "topic": "принятие",
      "used": false,
      "used_at": null
    },
    {
      "id": 75,
      "text": "Границы это не стены, это двери с замком изнутри",
      "topic": "границы",
      "used": false,
      "used_at": null
    },
    {
      "id": 76,
      "text": "Говорить нет это навык, который тренируется",
      "topic": "границы",
      "used": false,
      "used_at": null
    },
    {
      "id": 77,
      "text": "Ты не обязан объяснять свой отказ",
      "topic": "границы",
      "used": false,
      "used_at": null
    },
    {
      "id": 78,
      "text": "Забота о себе не эгоизм, а обслуживание инструмента",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 79,
      "text": "Сон это не потерянное время, это вложение",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 80,
      "text": "Тело помнит всё, что ты ему обещал и не сделал",
      "topic": "здоровье",
      "used": false,
      "used_at": null
    },
    {
      "id": 81,
      "text": "Движение лечит то, о чём молчит голова",
      "topic": "здоровье",
      "used": false,
      "used_at": null
    },
    {
      "id": 82,
      "text": "Начни с воды, сна и прогулки, остальное подтянется",
      "topic": "здоровье",
      "used": false,
      "used_at": null
    },
    {
      "id": 83,
      "text": "Мысль это гость, а не хозяин",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 84,
      "text": "Не верь всему, что думаешь",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 85,
      "text": "Тревога это долг, оплаченный за то, что может не случиться",
      "topic": "тревога",
      "used": false,
      "used_at": null
    },
    {
      "id": 86,
      "text": "Худшее уже происходило, и ты справился",
      "topic": "тревога",
      "used": false,
      "used_at": null
    },
    {
      "id": 87,
      "text": "Дыши, это уже половина решения",
      "topic": "спокойствие",
      "used": false,
      "used_at": null
    },
    {
      "id": 88,
      "text": "Сегодня не обязано быть продуктивным, чтобы быть хорошим",
      "topic": "принятие",
      "used": false,
      "used_at": null
    },
    {
      "id": 89,
      "text": "Достаточно это тоже результат",
      "topic": "принятие",
      "used": false,
      "used_at": null
    },
    {
      "id": 90,
      "text": "Мир не рухнет, если ты сделаешь паузу",
      "topic": "забота",
      "used": false,
      "used_at": null
    },
    {
      "id": 91,
      "text": "Ты можешь всё, но не одновременно",
      "topic": "фокус",
      "used": false,
      "used_at": null
    },
    {
      "id": 92,
      "text": "Планы меняются, направление остаётся",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 93,
      "text": "Если долго не получается, дело может быть в методе, а не в тебе",
      "topic": "рост",
      "used": false,
      "used_at": null
    },
    {
      "id": 94,
      "text": "Проси о помощи, это признак силы",
      "topic": "поддержка",
      "used": false,
      "used_at": null
    },
    {
      "id": 95,
      "text": "Рядом с правильными людьми ты становишься собой",
      "topic": "окружение",
      "used": false,
      "used_at": null
    },
    {
      "id": 96,
      "text": "Окружение делает больше, чем сила воли",
      "topic": "окружение",
      "used": false,
      "used_at": null
    },
    {
      "id": 97,
      "text": "Уходи оттуда, где тебя делают меньше",
      "topic": "окружение",
      "used": false,
      "used_at": null
    },
    {
      "id": 98,
      "text": "Ты не сложный, тебя просто не тем объясняли",
      "topic": "принятие",
      "used": false,
      "used_at": null
    },
    {
      "id": 99,
      "text": "Твой темп правильный, потому что он твой",
      "topic": "путь",
      "used": false,
      "used_at": null
    },
    {
      "id": 100,
      "text": "Через год ты будешь рад, что начал сегодня",
      "topic": "время",
      "used": false,
      "used_at": null
    },
    {
      "id": 101,
      "text": "Лучшее время было вчера, второе лучшее сейчас",
      "topic": "время",
      "used": false,
      "used_at": null
    },
    {
      "id": 102,
      "text": "Однажды это станет историей, которую ты рассказываешь",
      "topic": "путь",
      "used": false,
      "used_at": null
    }
  ]
}